# =============================================================================
# VoltaCliente — variáveis de ambiente
# Copie para ".env" (local) e configure na Vercel (Project › Settings › Environment Variables).
# NUNCA versione valores reais. Nenhum segredo abaixo é exposto ao navegador,
# exceto as variáveis com prefixo NEXT_PUBLIC_.
# =============================================================================

# --- Banco de dados (obrigatório) --------------------------------------------
# Local: PostgreSQL 14+.  Produção: Neon (https://neon.tech).
# No Neon, use a string "pooled" (host com "-pooler") em DATABASE_URL...
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/voltacliente?schema=public"
# ...e a string direta (sem "-pooler") em DIRECT_URL, usada apenas pelas migrações.
# Localmente pode ficar vazia (as migrações usam DATABASE_URL).
DIRECT_URL=""

# --- Autenticação (obrigatório) ----------------------------------------------
# Segredo para assinar sessões (32+ caracteres aleatórios). Gere com (PowerShell ou bash):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
BETTER_AUTH_SECRET=""
# URL pública da aplicação (sem barra no final). Ex.: https://voltacliente.com.br
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- E-mail transacional (opcional) ------------------------------------------
# Necessário para "Esqueci minha senha" em produção. Provedor: Resend (https://resend.com).
# Sem estas variáveis, em produção a recuperação de senha aparece como indisponível;
# em desenvolvimento, o link de redefinição é exibido no terminal.
RESEND_API_KEY=""
# Remetente verificado no Resend. Ex.: "VoltaCliente <nao-responda@seudominio.com.br>"
EMAIL_FROM=""

# --- Suporte (opcional) ------------------------------------------------------
# E-mail exibido na página /suporte.
NEXT_PUBLIC_SUPPORT_EMAIL=""

# --- Pagamentos — Mercado Pago (FUTURO; não utilizado nesta versão) ----------
# A camada está preparada, mas nenhuma cobrança é feita. Deixe em branco.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# --- Testes (opcional, apenas local) -----------------------------------------
# Banco SEPARADO para os testes de integração (o nome deve conter "test";
# os testes apagam os dados dele).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/voltacliente_test?schema=public"
