# ============================================================================
# J.A.R.V.I.S. — configuração local. Copie para .env.local (setup.cmd faz isso).
# .env.local NUNCA deve ser versionado. As chaves ficam só neste computador.
# ============================================================================

# --- Provedores de IA opcionais (nenhum é obrigatório; o padrão é o Ollama local)
# Só são usados depois que você autoriza provedores externos em Configurações › Privacidade.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Avançado (normalmente não precisa mexer)
# Porta/token são definidos pelo aplicativo desktop a cada execução.
# JARVIS_DATA_DIR=%APPDATA%\Jarvis\data
# JARVIS_PYTHON=C:\caminho\para\python.exe
