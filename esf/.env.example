# URL pública do site (usada em metadata, Open Graph, sitemap e robots).
# Na Vercel, se não for definida, usamos automaticamente VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=https://www.exemplo.org.br

# Link de doação exibido em "Apoie a ESF".
# - Não definida: usa o link de cobrança atualmente divulgado pela ESF (src/content/site.ts).
# - Definida como vazia (NEXT_PUBLIC_DONATION_URL=): oculta o botão de pagamento e direciona para o e-mail.
# IMPORTANTE: confirme a titularidade do recebimento antes de publicar.
# NEXT_PUBLIC_DONATION_URL=
