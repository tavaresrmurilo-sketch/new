// Mixtour — modelo de dados
// PostgreSQL 14+ com as extensões pg_trgm e unaccent (criadas na primeira migration).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Contas e autenticação
// ─────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  name            String
  passwordHash    String?
  emailVerifiedAt DateTime?
  avatarUrl       String?
  role            UserRole   @default(USER)
  status          UserStatus @default(ACTIVE)

  // Preferências do explorador
  homeCity            String?
  homeLat             Float?
  homeLng             Float?
  favoriteCategories  String[]   @default([])
  notifyEmail         Boolean    @default(true)
  notifyPush          Boolean    @default(true)
  marketingOptIn      Boolean    @default(false)
  termsAcceptedAt     DateTime?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  sessions          Session[]
  oauthAccounts     OAuthAccount[]
  tokens            VerificationToken[]
  memberships       Membership[]
  saves             EventSave[]
  rsvps             EventRsvp[]
  follows           Follow[]
  notifications     Notification[]
  reports           Report[]           @relation("ReportReporter")
  resolvedReports   Report[]           @relation("ReportResolver")
  createdEvents     Event[]            @relation("EventCreator")
  reviewedEvents    Event[]            @relation("EventReviewer")
  uploads           Upload[]
  pushSubscriptions PushSubscription[]
  deviceTokens      DeviceToken[]
  auditLogs         AuditLog[]
  sentInvites       OrgInvite[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model Session {
  id             String   @id @default(cuid())
  tokenHash      String   @unique
  userId         String
  ip             String?
  userAgent      String?
  expiresAt      DateTime
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────
// Organizações (clientes B2B do SaaS)
// ─────────────────────────────────────────────────────────────

enum PlanTier {
  FREE
  PRO
  BUSINESS
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
}

model Organization {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  bio         String?
  logoUrl     String?
  coverUrl    String?
  website     String?
  instagram   String?
  whatsapp    String?
  contactEmail String?
  city        String?
  state       String?
  status      OrgStatus @default(ACTIVE)

  /// Selo "verificado" concedido pela equipe Mixtour.
  verified         Boolean @default(false)
  /// Publica sem análise prévia (concedido pela moderação).
  trustedPublisher Boolean @default(false)

  plan             PlanTier @default(FREE)
  stripeCustomerId String?  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       Membership[]
  invites       OrgInvite[]
  venues        Venue[]
  events        Event[]
  followers     Follow[]
  subscription  Subscription?
  boosts        EventBoost[]
  reports       Report[]
  uploads       Upload[]

  @@index([status])
  @@index([plan])
}

enum OrgRole {
  OWNER
  ADMIN
  EDITOR
}

model Membership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole  @default(EDITOR)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model OrgInvite {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           OrgRole   @default(EDITOR)
  tokenHash      String    @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
  PAUSED
}

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  stripeSubscriptionId String             @unique
  stripePriceId        String
  tier                 PlanTier
  status               SubscriptionStatus
  interval             String             @default("month")
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// Configuração comercial de cada plano (editável no /admin).
model Plan {
  tier                 PlanTier @id
  name                 String
  tagline              String
  priceMonthlyCents    Int
  priceYearlyCents     Int?
  stripePriceMonthly   String?
  stripePriceYearly    String?
  /// null = ilimitado
  maxActiveEvents      Int?
  maxMembers           Int
  maxVenues            Int?
  boostsPerMonth       Int
  fullAnalytics        Boolean
  csvExport            Boolean
  highlightBadge       Boolean
  active               Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

/// Eventos de webhook do Stripe já processados (idempotência).
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// Locais e eventos
// ─────────────────────────────────────────────────────────────

model Venue {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  address        String
  neighborhood   String?
  city           String
  state          String?
  postalCode     String?
  country        String   @default("BR")
  lat            Float
  lng            Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       Event[]

  @@index([organizationId])
}

model Category {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  /// Nome do ícone (lucide) — mapeado no cliente.
  icon      String
  /// Cor da categoria em hexadecimal (#RRGGBB).
  color     String
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  events Event[]
}

enum EventStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  CANCELED
  ARCHIVED
}

enum AgeRating {
  LIVRE
  A10
  A12
  A14
  A16
  A18
}

model Event {
  id             String      @id @default(cuid())
  slug           String      @unique
  organizationId String
  createdById    String?
  categoryId     String
  title          String
  summary        String?
  description    String?
  coverUrl       String?
  coverThumbUrl  String?
  coverColor     String?
  status         EventStatus @default(DRAFT)
  rejectionReason String?
  reviewedById   String?
  reviewedAt     DateTime?
  submittedAt    DateTime?
  publishedAt    DateTime?
  canceledAt     DateTime?

  startsAt DateTime
  endsAt   DateTime
  timezone String   @default("America/Sao_Paulo")

  venueId      String?
  venueName    String
  address      String
  neighborhood String?
  city         String
  state        String?
  postalCode   String?
  lat          Float
  lng          Float

  isFree         Boolean   @default(false)
  priceMinCents  Int?
  priceMaxCents  Int?
  currency       String    @default("BRL")
  ticketUrl      String?
  ticketProvider String?
  ageRating      AgeRating @default(LIVRE)
  accessibility  String[]  @default([])
  tags           String[]  @default([])

  featuredUntil DateTime?

  viewsCount   Int @default(0)
  savesCount   Int @default(0)
  goingCount   Int @default(0)
  ticketClicks Int @default(0)
  sharesCount  Int @default(0)

  /// Mantido pelo banco (coluna gerada): busca textual sem acentos.
  searchVector Unsupported("tsvector")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?               @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy   User?               @relation("EventReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  category     Category            @relation(fields: [categoryId], references: [id])
  venue        Venue?              @relation(fields: [venueId], references: [id], onDelete: SetNull)
  saves        EventSave[]
  rsvps        EventRsvp[]
  metrics      EventMetricDaily[]
  viewMarks    EventViewMark[]
  boosts       EventBoost[]
  reports      Report[]

  @@index([status, startsAt])
  @@index([status, endsAt])
  @@index([lat, lng])
  @@index([organizationId, startsAt])
  @@index([categoryId])
  @@index([city])
  @@index([featuredUntil])
  @@index([searchVector], type: Gin)
}

model EventSave {
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@index([eventId])
}

enum RsvpStatus {
  GOING
  INTERESTED
}

model EventRsvp {
  userId         String
  eventId        String
  status         RsvpStatus @default(GOING)
  reminderSentAt DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@index([eventId])
}

model Follow {
  userId         String
  organizationId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, organizationId])
  @@index([organizationId])
}

/// Métricas diárias agregadas por evento (painel do organizador).
model EventMetricDaily {
  eventId      String
  day          DateTime @db.Date
  views        Int      @default(0)
  uniqueViews  Int      @default(0)
  saves        Int      @default(0)
  going        Int      @default(0)
  ticketClicks Int      @default(0)
  shares       Int      @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, day])
}

/// Marca de visualização única (visitante anônimo por hash diário). Limpa pela rotina de manutenção.
model EventViewMark {
  eventId     String
  visitorHash String
  day         DateTime @db.Date

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, visitorHash, day])
  @@index([day])
}

/// Destaque pago/incluído no plano: aumenta a visibilidade no mapa e na lista.
model EventBoost {
  id             String   @id @default(cuid())
  eventId        String
  organizationId String
  startsAt       DateTime
  endsAt         DateTime
  createdById    String?
  createdAt      DateTime @default(now())

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([eventId])
}

// ─────────────────────────────────────────────────────────────
// Moderação, notificações e operação
// ─────────────────────────────────────────────────────────────

enum ReportReason {
  SPAM
  FRAUD
  INAPPROPRIATE
  WRONG_INFO
  CANCELED_EVENT
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Report {
  id             String       @id @default(cuid())
  eventId        String?
  organizationId String?
  reporterId     String?
  reporterIpHash String?
  reason         ReportReason
  details        String?
  status         ReportStatus @default(OPEN)
  resolution     String?
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())

  event        Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reporter     User?         @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  resolvedBy   User?         @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([eventId])
}

enum NotificationType {
  EVENT_REMINDER
  EVENT_UPDATED
  EVENT_CANCELED
  NEW_EVENT_FROM_FOLLOWED
  EVENT_APPROVED
  EVENT_REJECTED
  ORG_INVITE
  BILLING
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  url       String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum DevicePlatform {
  ANDROID
  IOS
}

/// Token de push do app nativo (FCM no Android, APNs no iOS).
model DeviceToken {
  id         String         @id @default(cuid())
  userId     String
  platform   DevicePlatform
  token      String         @unique
  appVersion String?
  createdAt  DateTime       @default(now())
  lastSeenAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// Todo e-mail enviado passa por aqui (auditoria e reenvio). Sem provedor configurado: status SKIPPED.
model EmailOutbox {
  id                String      @id @default(cuid())
  to                String
  subject           String
  template          String
  html              String
  text              String
  status            EmailStatus @default(PENDING)
  provider          String?
  providerMessageId String?
  error             String?
  attempts          Int         @default(0)
  createdAt         DateTime    @default(now())
  sentAt            DateTime?

  @@index([status, createdAt])
  @@index([to])
}

model Upload {
  id             String   @id @default(cuid())
  key            String   @unique
  url            String
  thumbUrl       String?
  mimeType       String
  width          Int
  height         Int
  bytes          Int
  dominantColor  String?
  purpose        String
  uploadedById   String?
  organizationId String?
  createdAt      DateTime @default(now())

  uploadedBy   User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
  @@index([targetType, targetId])
}

/// Limitador de taxa compartilhado entre instâncias (janela fixa).
model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime

  @@index([resetAt])
}

model GeocodeCache {
  id        String   @id @default(cuid())
  queryHash String   @unique
  kind      String
  query     String
  result    Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Configurações da plataforma (ex.: modo de moderação), editáveis no /admin.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Execuções das rotinas agendadas (observabilidade).
model JobRun {
  id         String    @id @default(cuid())
  job        String
  status     String
  detail     Json?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([job, startedAt])
}
