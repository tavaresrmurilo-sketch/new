# ─────────────────────────────────────────────────────────────
# JR Córtex V2 — variáveis de ambiente
# Copie para .env (local) e configure no painel da Vercel (produção).
# Nunca versione o arquivo .env com valores reais.
# ─────────────────────────────────────────────────────────────

# Banco PostgreSQL (Neon recomendado). Use a connection string *pooled* (host com -pooler).
DATABASE_URL="postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require"

# Segredo de sessões/criptografia (mín. 32 caracteres aleatórios). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""
# Opcional: chave própria (32 bytes em base64) para cifrar segredos de webhooks. Vazio = derivada do AUTH_SECRET.
ENCRYPTION_KEY=""

# URL pública da aplicação (sem barra no final). Ex.: https://cortex.suaempresa.com.br
APP_URL="http://localhost:3000"

# ── Córtex AI (opcional). Sem provedor, o app funciona e exibe:
#    "Configure um provedor de IA para utilizar o Córtex AI."
# AI_PROVIDER: anthropic | openai | gemini | local  (vazio = detecta pela chave disponível)
AI_PROVIDER=""
AI_MODEL=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
GOOGLE_GENERATIVE_AI_API_KEY=""
# Modelo local compatível com a API OpenAI (ex.: Ollama): http://localhost:11434/v1
LOCAL_AI_URL=""

# ── E-mail transacional (opcional). Sem chave, convites geram link para copiar.
RESEND_API_KEY=""
EMAIL_FROM="JR Córtex <no-reply@seudominio.com.br>"

# ── Armazenamento de arquivos: database (padrão, sem configuração) | s3 (S3, Cloudflare R2, Supabase Storage) | local (apenas servidor próprio)
STORAGE_PROVIDER="database"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
STORAGE_LOCAL_DIR="./storage"

# ── Cobrança (opcional). Configure os price IDs de cada plano em /admin/plans.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Jobs agendados: o agendador envia "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=""

# ── Modo demonstração público (/demo). true apenas se desejar demos públicas.
DEMO_MODE_ENABLED="false"

# ── Sessões (opcional)
SESSION_MAX_AGE_HOURS="168"
SESSION_IDLE_MINUTES="720"

# ── Seed (npm run db:seed) — usados apenas pelo script de seed
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""
SUPER_ADMIN_NAME="Administrador"
# true cria um workspace de DEMONSTRAÇÃO (dados fictícios sinalizados). Nunca use em produção real.
SEED_DEMO="false"
DEMO_USER_PASSWORD=""
