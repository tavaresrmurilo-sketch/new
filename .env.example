# Banco de dados PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jrcortex?schema=public"

# Segredo de sessão (mínimo 32 caracteres). Gere com: openssl rand -base64 48
AUTH_SECRET=

# Provedor de IA: rules (motor determinístico interno, sem chave), claude, openai, gemini, local
AI_PROVIDER=rules
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
# Endpoint compatível com OpenAI para LLM local (ex.: Ollama http://localhost:11434/v1)
LOCAL_LLM_URL=

# Chave do Credentials Vault (32 bytes em base64). Gere com: openssl rand -base64 32
ENCRYPTION_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opcional
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_MAX_AGE_HOURS=12
LOG_LEVEL=info
