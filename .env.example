# Banco de dados PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jrcortex?schema=public"
# Opcional (Neon): URL DIRETA, sem "-pooler" no host. Usada só para rodar as migrations no deploy da Vercel.
# Se vazia, as migrations usam DATABASE_URL.
DIRECT_URL=

# Segredo de sessão (mínimo 32 caracteres). Gere com (PowerShell ou terminal): node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=

# Provedor de IA: rules (motor determinístico interno, sem chave), claude, openai, gemini, local
AI_PROVIDER=rules
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
# Endpoint compatível com OpenAI para LLM local (ex.: Ollama http://localhost:11434/v1)
LOCAL_LLM_URL=

# Chave do Credentials Vault (32 bytes em base64). Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opcional
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_MAX_AGE_HOURS=12
LOG_LEVEL=info

# Protege /api/jobs/run (Vercel Cron via GET ou cron externo via POST). Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRON_SECRET=

# ── Conectar Dados (fontes externas: bancos e APIs dos clientes) ──
# As credenciais dos clientes NUNCA vão para este arquivo: ficam cifradas (ENCRYPTION_KEY) no banco interno.
# Somente em desenvolvimento/testes: permite conectar a bancos em localhost/rede privada. Em produção deixe vazio.
ALLOW_PRIVATE_DB_HOSTS=
# Máximo de linhas lidas por tabela em cada sincronização (o restante segue na próxima execução)
SYNC_MAX_ROWS_PER_TABLE=50000

# Administrador principal (criado por `npm run db:seed` ou `npm run admin:create` se ainda não existir).
# Nunca commite valores reais. Senha: mínimo de 10 caracteres com letras e números.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Seed (opcional): senha dos usuários do ambiente demonstrativo
SEED_DEMO_PASSWORD=
SEED_SKIP_DEMO=0
# 1 = apaga e recria o tenant JR Demo (apenas dados demonstrativos). Padrão: o seed mantém o demo existente.
SEED_RESET_DEMO=0

# (Opcional) URL verificada por `npm run pre-demo` — padrão http://localhost:3000
PRE_DEMO_URL=
