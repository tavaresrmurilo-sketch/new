# ─────────────────────────────────────────────────────────────
# Mixtour — variáveis de ambiente
# Copie para .env e preencha. Itens marcados (opcional) desativam o recurso
# correspondente quando vazios — nada é simulado.
# ─────────────────────────────────────────────────────────────

# Banco de dados (PostgreSQL 14+). Neon/Supabase: use a URL com pooling aqui
# e a conexão direta em DIRECT_URL (usada só para migrations no deploy).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mixtour?schema=public"
DIRECT_URL=""

# URL pública do app (sem barra no final). Usada em e-mails, OAuth e SEO.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Segredo de sessão/tokens — gere com: openssl rand -base64 48
AUTH_SECRET=""
SESSION_MAX_AGE_DAYS=30

# Conta de administrador criada/confirmada pelo seed (npm run db:seed)
ADMIN_NAME="Equipe Mixtour"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""          # mínimo 12 caracteres
ADMIN_RESET_PASSWORD=false # true = redefine a senha do admin no próximo seed

# ── Mapa (MapLibre) ──────────────────────────────────────────
# Estilos vetoriais sem chave do OpenFreeMap por padrão. Para MapTiler/Stadia,
# cole a URL do style.json (com a chave). "blank" = mapa sem tiles (testes offline).
NEXT_PUBLIC_MAP_STYLE_DARK="https://tiles.openfreemap.org/styles/dark"
NEXT_PUBLIC_MAP_STYLE_LIGHT="https://tiles.openfreemap.org/styles/positron"
# Domínios extras liberados no CSP para tiles/glyphs/sprites (separados por espaço)
MAP_CSP_HOSTS="https://tiles.openfreemap.org"

# ── Geocodificação (busca de endereços) ──────────────────────
# nominatim = OpenStreetMap (gratuito, 1 req/s). none = só pino manual no mapa.
GEOCODER="nominatim"
NOMINATIM_URL="https://nominatim.openstreetmap.org"
GEOCODER_CONTACT_EMAIL=""  # exigido pela política do Nominatim público
GEOCODER_COUNTRY_CODES="br"

# ── E-mail transacional ──────────────────────────────────────
# resend | smtp | none (none = registra no outbox, sem enviar)
EMAIL_PROVIDER="none"
EMAIL_FROM="Mixtour <nao-responda@seudominio.com.br>"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE=false

# ── Login com Google (opcional) ──────────────────────────────
# Redirect URI autorizada: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Imagens ──────────────────────────────────────────────────
# local = pasta ./storage (dev/servidor próprio). s3 = R2/S3/Supabase/MinIO (obrigatório na Vercel)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/uploads"
S3_ENDPOINT=""             # R2: https://<account-id>.r2.cloudflarestorage.com
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""           # URL pública do bucket (ex.: https://img.seudominio.com.br)
S3_FORCE_PATH_STYLE=false

# ── Assinaturas (Stripe) ─────────────────────────────────────
# Webhook: {APP_URL}/api/billing/webhook
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_BUSINESS_MONTHLY=""
STRIPE_PRICE_BUSINESS_YEARLY=""

# ── Web Push (opcional) ──────────────────────────────────────
# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_SUBJECT="mailto:contato@seudominio.com.br"

# ── Rotinas agendadas ────────────────────────────────────────
# A Vercel envia "Authorization: Bearer $CRON_SECRET" automaticamente.
CRON_SECRET=""

# Atrás de proxy reverso próprio (nginx etc.), confie em X-Forwarded-For:
TRUST_PROXY=false
