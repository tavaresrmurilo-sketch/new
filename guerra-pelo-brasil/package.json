{
  "name": "guerra-pelo-brasil",
  "version": "1.0.0",
  "private": true,
  "description": "GUERRA PELO BRASIL — CONQUISTA TOTAL. RTS satírico 2D para navegador (Phaser 3 + TypeScript + Vite).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "map": "node scripts/build-map.mjs",
    "simulate": "vitest run tests/fullmatch.test.ts",
    "release": "npm run build && node scripts/release.mjs",
    "dev:server": "tsx watch server/index.ts",
    "build:server": "node scripts/build-server.mjs",
    "build:all": "npm run build && npm run build:server",
    "start": "node dist-server/server.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "phaser": "^3.90.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.25.12",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^7.3.8",
    "vitest": "^5.1.1",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
