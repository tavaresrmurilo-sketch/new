# ---------- Servidor multiplayer (Railway, Docker ou local) ----------
# Porta HTTP/WebSocket (Railway define automaticamente)
PORT=8787
HOST=0.0.0.0
# Origens autorizadas a conectar (separadas por vírgula). "*" libera todas.
# Exemplo de produção: https://guerra-pelo-brasil.vercel.app,null   ("null" = arquivo .html aberto localmente)
ALLOWED_ORIGINS=*
# Pasta para partidas em andamento, histórico e replays (use um volume persistente no Railway)
DATA_DIR=./data-server
# Pasta do cliente gerado por "npm run build" (servido pelo próprio servidor)
STATIC_DIR=./dist
LOG_LEVEL=info
MAX_ROOMS=100

# ---------- Cliente (Vercel): endereço do servidor multiplayer ----------
# Usado no build do front quando ele não é servido pelo próprio servidor.
VITE_SERVER_URL=https://seu-servidor.up.railway.app
