# ─────────────────────────────────────────────────────────────
# CHAVIX 3D — variáveis de ambiente
# Copie para .env e preencha. Nunca envie o .env para o GitHub.
# ─────────────────────────────────────────────────────────────

# Banco PostgreSQL (use a URL com pooling em produção, ex.: Neon/Supabase/Vercel Postgres)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/chavix?schema=public"
# Opcional: URL direta (sem pooler) usada apenas pelas migrations
DIRECT_URL=

# URL pública do site (sem barra no final). Usada em SEO, sitemap e links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Segredo para assinar cookies (mínimo 32 caracteres aleatórios).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# ── Pix (recebimento direto, sem intermediador) ──
# Chave Pix: CPF/CNPJ só números, e-mail, telefone (+55DDD...) ou chave aleatória
PIX_KEY=
# Nome do recebedor como aparece no banco (até 25 caracteres, sem acentos de preferência)
PIX_RECEIVER_NAME=
# Cidade do recebedor (até 15 caracteres)
PIX_CITY=

# ── Administrador inicial (usado por `npm run db:seed` e `npm run admin:create`) ──
ADMIN_NAME=
ADMIN_EMAIL=
# Senha forte: mínimo 10 caracteres. Troque depois do primeiro acesso.
ADMIN_PASSWORD=

# ── Armazenamento de imagens ──
# "database" (padrão, funciona em qualquer lugar) ou "vercel-blob"
STORAGE_DRIVER=database
# Necessário apenas com STORAGE_DRIVER=vercel-blob (criado automaticamente ao conectar um Blob Store na Vercel)
BLOB_READ_WRITE_TOKEN=

# Opcional: banco separado para os testes de integração (npm test). Sem ele, esses testes são pulados.
TEST_DATABASE_URL=

# Seed: "false" cria apenas categorias, configurações e admin (sem produtos de demonstração)
SEED_DEMO_PRODUCTS=true
