// CHAVIX 3D — modelo de dados
// Valores monetários SEMPRE em centavos (Int). Nunca Float para dinheiro.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Autenticação ─────────────────────────

/// Identidade de login. Hoje usada pelos administradores; pronta para contas de cliente no futuro.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  admin        Admin?
  sessions     Session[]
}

enum AdminRole {
  OWNER
  MANAGER
}

/// Perfil com acesso ao painel /admin.
model Admin {
  id                String               @id @default(cuid())
  userId            String               @unique
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              AdminRole            @default(OWNER)
  active            Boolean              @default(true)
  lastLoginAt       DateTime?
  failedLoginCount  Int                  @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime             @default(now())
  statusChanges     OrderStatusHistory[]
  confirmedPayments Payment[]
}

/// Sessão do painel. Guardamos apenas o hash SHA-256 do token do cookie.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
}

// ───────────────────────── Catálogo ─────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  position    Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([active, position])
}

model Product {
  id                  String           @id @default(cuid())
  name                String
  slug                String           @unique
  sku                 String           @unique
  shortDescription    String
  description         String
  /// Preço cheio em centavos
  priceCents          Int
  /// Preço promocional opcional em centavos (vale quando menor que o preço cheio)
  promoPriceCents     Int?
  /// Preço efetivo (promocional quando houver) — mantido pelo sistema para filtros e ordenação
  effectivePriceCents Int              @default(0)
  categoryId          String
  category            Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  stock               Int              @default(0)
  /// Quando true, aceita pedidos sem estoque (produção sob demanda)
  allowBackorder      Boolean          @default(true)
  active              Boolean          @default(true)
  featured            Boolean          @default(false)
  isNew               Boolean          @default(false)
  isBestSeller        Boolean          @default(false)
  /// Unidades vendidas com pagamento confirmado (atualizado pelo sistema)
  salesCount          Int              @default(0)
  minQuantity         Int              @default(1)
  maxQuantity         Int              @default(50)
  // Medidas físicas (não monetárias)
  widthMm             Float?
  heightMm            Float?
  depthMm             Float?
  weightGrams         Float?
  material            String           @default("PLA")
  /// Prazo estimado de produção em dias úteis
  productionDays      Int              @default(3)
  /// Texto normalizado (minúsculo, sem acento) para busca
  searchText          String           @default("")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  images              ProductImage[]
  variants            ProductVariant[]
  customizations      Customization[]
  orderItems          OrderItem[]
  cartItems           CartItem[]

  @@index([categoryId])
  @@index([active, createdAt])
  @@index([active, effectivePriceCents])
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url        String
  thumbUrl   String
  /// Identificador no armazenamento (id do arquivo no banco ou URL do blob) para exclusão
  storageKey String?
  thumbKey   String?
  alt        String   @default("")
  width      Int
  height     Int
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([productId, position])
}

/// Cores/acabamentos disponíveis de um produto
model ProductVariant {
  id              String      @id @default(cuid())
  productId       String
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  colorHex        String
  priceDeltaCents Int         @default(0)
  active          Boolean     @default(true)
  position        Int         @default(0)
  cartItems       CartItem[]
  orderItems      OrderItem[]

  @@index([productId])
}

enum CustomizationType {
  TEXT
  SELECT
}

/// Opção de personalização de um produto (ex.: nome gravado, tipo de argola)
model Customization {
  id          String            @id @default(cuid())
  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  label       String
  type        CustomizationType
  required    Boolean           @default(false)
  placeholder String?
  maxLength   Int?
  /// Valor adicional em centavos (TEXT: cobrado quando preenchido)
  priceCents  Int               @default(0)
  /// SELECT: lista de { label, priceCents }
  options     Json?
  position    Int               @default(0)

  @@index([productId])
}

// ───────────────────────── Carrinho ─────────────────────────

enum ItemKind {
  PRODUCT
  CUSTOM
}

/// Carrinho anônimo identificado por cookie. Preços NUNCA são guardados aqui.
model Cart {
  id                String     @id @default(cuid())
  token             String     @unique
  couponCode        String?
  checkoutStartedAt DateTime?
  convertedAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  items             CartItem[]

  @@index([createdAt])
}

model CartItem {
  id                  String          @id @default(cuid())
  cartId              String
  cart                Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  kind                ItemKind        @default(PRODUCT)
  productId           String?
  product             Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId           String?
  variant             ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity            Int
  /// { [customizationId]: valor escolhido }
  customizationValues Json?
  /// Seleção do chaveiro personalizado (formato, cor, texto, observações)
  customData          Json?
  referenceFileId     String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([cartId])
}

// ───────────────────────── Clientes e pedidos ─────────────────────────

model Customer {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  phone        String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  addresses    Address[]
  orders       Order[]
  couponUsages CouponUsage[]
}

/// Endereços são imutáveis: cada alteração cria um novo registro, preservando o histórico dos pedidos.
model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  cep        String
  street     String
  number     String
  complement String?
  district   String
  city       String
  state      String
  createdAt  DateTime @default(now())
  orders     Order[]

  @@index([customerId])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW
  PAID
  IN_PRODUCTION
  READY
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ShippingMethod {
  PICKUP
  LOCAL_DELIVERY
  NATIONAL
}

model Order {
  id             String               @id @default(cuid())
  /// Código público não sequencial, ex.: CHX-A82F91
  code           String               @unique
  status         OrderStatus          @default(PENDING_PAYMENT)
  customerId     String
  customer       Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  // Cópia dos dados de contato no momento da compra
  customerName   String
  customerEmail  String
  customerPhone  String
  addressId      String?
  address        Address?             @relation(fields: [addressId], references: [id], onDelete: Restrict)
  shippingMethod ShippingMethod
  shippingLabel  String
  shippingDays   Int?
  subtotalCents  Int
  discountCents  Int                  @default(0)
  shippingCents  Int                  @default(0)
  totalCents     Int
  couponCode     String?
  productionDays Int
  hasCustomItems Boolean              @default(false)
  notes          String?
  internalNotes  String?
  trackingCode   String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  paidAt         DateTime?
  cancelledAt    DateTime?
  items          OrderItem[]
  payment        Payment?
  history        OrderStatusHistory[]
  couponUsage    CouponUsage?
  review         Review?

  @@index([status, createdAt])
  @@index([customerId])
  @@index([createdAt])
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind            ItemKind        @default(PRODUCT)
  productId       String?
  product         Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  // Cópias no momento da compra
  productName     String
  productSku      String?
  variantName     String?
  categoryName    String?
  imageUrl        String?
  unitPriceCents  Int
  quantity        Int
  /// Taxa única da linha (ex.: modelagem a partir de referência)
  setupFeeCents   Int             @default(0)
  totalCents      Int
  /// Lista de { label, value, priceCents } escolhidos pelo cliente
  options         Json
  customData      Json?
  referenceFileId String?
  /// Quantas unidades saíram do estoque (devolvidas em caso de cancelamento)
  stockReserved   Int             @default(0)

  @@index([orderId])
  @@index([productId])
}

enum PaymentStatus {
  PENDING
  UNDER_REVIEW
  CONFIRMED
  CANCELLED
}

model Payment {
  id                 String        @id @default(cuid())
  orderId            String        @unique
  order              Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method             String        @default("PIX")
  amountCents        Int
  /// Identificador da transação no BR Code (campo 62-05)
  txid               String
  /// Pix Copia e Cola gerado na criação do pedido
  pixPayload         String
  status             PaymentStatus @default(PENDING)
  customerReportedAt DateTime?
  confirmedAt        DateTime?
  confirmedById      String?
  confirmedBy        Admin?        @relation(fields: [confirmedById], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

enum HistoryActor {
  SYSTEM
  CUSTOMER
  ADMIN
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actor      HistoryActor
  adminId    String?
  admin      Admin?       @relation(fields: [adminId], references: [id], onDelete: SetNull)
  /// Nome do administrador no momento da ação (mantido mesmo se o admin for removido)
  actorName  String?
  note       String?
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
}

// ───────────────────────── Cupons ─────────────────────────

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id                String        @id @default(cuid())
  code              String        @unique
  description       String?
  type              CouponType
  /// PERCENT: 1 a 100 · FIXED: valor em centavos
  value             Int
  minSubtotalCents  Int?
  maxUses           Int?
  usedCount         Int           @default(0)
  startsAt          DateTime?
  expiresAt         DateTime?
  active            Boolean       @default(false)
  firstPurchaseOnly Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  usages            CouponUsage[]
}

model CouponUsage {
  id            String    @id @default(cuid())
  couponId      String
  coupon        Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId       String    @unique
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  discountCents Int
  createdAt     DateTime  @default(now())

  @@index([couponId])
}

// ───────────────────────── Avaliações ─────────────────────────

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

/// Avaliação feita pelo próprio cliente após a entrega (compra verificada).
model Review {
  id          String       @id @default(cuid())
  orderId     String       @unique
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  displayName String
  rating      Int
  comment     String
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, createdAt])
}

// ───────────────────────── Configurações e infraestrutura ─────────────────────────

/// Configurações editáveis pelo painel (linha única, id = "default")
model StoreSettings {
  id             String   @id @default("default")
  storeName      String   @default("CHAVIX 3D")
  whatsappNumber String?
  contactEmail   String?
  instagram      String?
  announcement   String?
  pickupAddress  String?
  /// Configuração de frete (validada por Zod em src/lib/shipping)
  shipping       Json
  /// Tabela de preços do chaveiro personalizado (validada por Zod)
  customBuilder  Json
  updatedAt      DateTime @updatedAt
}

enum FileKind {
  PRODUCT_IMAGE
  CUSTOMER_REFERENCE
}

/// Arquivos guardados no próprio banco (driver "database" e referências de clientes)
model StoredFile {
  id          String   @id @default(cuid())
  kind        FileKind
  contentType String
  size        Int
  width       Int?
  height      Int?
  data        Bytes
  /// Hash do token do carrinho que enviou a referência (controle de acesso)
  ownerHash   String?
  createdAt   DateTime @default(now())

  @@index([kind, createdAt])
}

/// Janela fixa de rate limiting compartilhada entre instâncias serverless
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}
